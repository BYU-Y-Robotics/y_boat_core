ARG BASE_IMAGE=ros:jazzy-ros-base

FROM ${BASE_IMAGE}


ARG WORKSPACE=/workspace
ENV ROS_DISTRO=jazzy
ENV ROS_SOURCE=/opt/ros/jazzy/setup.bash
ENV DEBIAN_FRONTEND=noninteractive

# Build tooling, plus MAVROS: the ROS 2 <-> ArduPilot bridge used by boat_control.
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    python3-colcon-common-extensions \
    python3-pip \
    udev \
    ros-${ROS_DISTRO}-mavros \
    ros-${ROS_DISTRO}-mavros-extras \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    && rm -rf /var/lib/apt/lists/* 

# MAVROS needs the GeographicLib geoid datasets; without them its node exits on startup.
RUN bash /opt/ros/${ROS_DISTRO}/lib/mavros/install_geographiclib_datasets.sh

WORKDIR ${WORKSPACE}

# entrypoint.sh only sources ROS for PID 1; this covers `docker exec` shells too.
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "[ -f ${WORKSPACE}/install/setup.bash ] && source ${WORKSPACE}/install/setup.bash" >> /root/.bashrc

COPY .docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR ${WORKSPACE}

COPY .docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
RUN echo 'source ${ROS_SOURCE}' >> /root/.bashrc

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
